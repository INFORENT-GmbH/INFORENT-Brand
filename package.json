{
  "name": "@inforent/brand",
  "version": "1.2.0",
  "description": "INFORENT Corporate Identity: Design-Tokens, Basis-CSS, typisierte Variablennamen, Wortmarke und brand-lint — gemeinsame Quelle für Portal und Website",
  "license": "UNLICENSED",
  "repository": "github:INFORENT-GmbH/INFORENT-Brand",
  "type": "module",
  "files": [
    "tokens.css",
    "base.css",
    "vars.js",
    "vars.d.ts",
    "logo.png",
    "bin/brand-lint.mjs"
  ],
  "exports": {
    "./tokens.css": "./tokens.css",
    "./base.css": "./base.css",
    "./vars": {
      "types": "./vars.d.ts",
      "default": "./vars.js"
    },
    "./logo.png": "./logo.png",
    "./package.json": "./package.json"
  },
  "scripts": {
    "check": "node scripts/check.mjs && node scripts/gen.mjs --check && node scripts/preview.mjs --check",
    "gen": "node scripts/gen.mjs",
    "preview": "node scripts/preview.mjs",
    "site": "node scripts/site.mjs",
    "deploy": "node scripts/deploy-sftp.mjs"
  },
  "bin": {
    "brand-lint": "bin/brand-lint.mjs"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "ssh2-sftp-client": "^12.1.1"
  }
}
